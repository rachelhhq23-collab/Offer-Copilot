# ============================================
# 演示模式专用配置 (仅 ?mode=demo 时读取)
# 正常用户模式下这些变量完全不会被使用
# 用户必须在前端引导向导中填写自己的配置
# ============================================

# 钉钉开放平台配置
DEMO_DINGTALK_APP_KEY=your_demo_dingtalk_app_key
DEMO_DINGTALK_APP_SECRET=your_demo_dingtalk_app_secret
DEMO_DINGTALK_BASE_ID=your_demo_dingtalk_base_id
DEMO_DINGTALK_TABLE_ID=your_demo_dingtalk_table_id

# 操作人 unionId (演示模式用)
DEMO_DINGTALK_OPERATOR_ID=your_demo_union_id

# DeepSeek API (文本模型, 演示模式用)
DEMO_DEEPSEEK_API_KEY=your_demo_deepseek_api_key

# 阿里云百炼 / 千问 API (视觉模型, 演示模式用)
DEMO_QWEN_API_KEY=your_demo_qwen_api_key

# ============================================
# AI 模型配置 (非密钥, 两种模式共用)
# ============================================
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_MODEL=qwen-vl-flash
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
